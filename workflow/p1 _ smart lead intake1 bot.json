    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "seen_emails = set()\nclean_items = []\n\nfor item in _items:\n    j = item.get('json', {}) or {}\n\n    # Unwrap body when the data arrives from the Webhook\n    b = j.get('body') if isinstance(j.get('body'), dict) else {}\n    b = b or {}\n\n    def pick(*keys, default=''):\n        for k in keys:\n            v = j.get(k)\n            if v not in (None, ''):\n                return v\n        for k in keys:\n            v = b.get(k)\n            if v not in (None, ''):\n                return v\n        return default\n\n    email = str(pick('email')).strip().lower()\n\n    # Skip duplicate emails inside the same batch\n    if email:\n        if email in seen_emails:\n            continue\n        seen_emails.add(email)\n\n    clean_items.append({'json': {\n        'name': str(pick('name')).strip(),\n        'email': email,\n        'phone': str(pick('phone')).strip(),\n        'company': str(pick('company')).strip(),\n        'service_interest': pick('service_interest', 'service_requested'),\n        'message': pick('message', 'snippet'),\n        'language': (str(pick('language', default='EN')).strip().upper() or 'EN'),\n        'source': pick('source', default='webhook'),\n        'sessionId': pick('sessionId', 'session_id'),\n        'received_at': pick('received_at', 'timestamp'),\n    }})\n\nreturn clean_items\n"
      },
